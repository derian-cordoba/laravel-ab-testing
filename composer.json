{
    "name": "derian-cordoba/laravel-ab-testing",
    "description": "AB testing package for laravel",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "autoload": {
        "files": [
            "src/helpers.php"
        ],
        "psr-4": {
            "ABTests\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ABTests\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Derian Cordoba"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/support": "^13.0",
        "illuminate/console": "^13.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "ABTests\\ABTestingServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "larastan/larastan": "^3.10",
        "phpunit/phpunit": "^13.2"
    }
}
