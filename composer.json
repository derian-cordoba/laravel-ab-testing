{
    "name": "derian-cordoba/laravel-ab-testing",
    "description": "AB testing package for laravel",
    "type": "library",
    "license": "MIT",
    "version": "1.2.0",
    "autoload": {
        "files": [
            "src/helpers.php"
        ],
        "psr-4": {
            "ABTests\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ABTests\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Derian Cordoba",
            "email": "derian.cordoba@icloud.com"
        }
    ],
    "require": {
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "livewire/livewire": "^4.0",
        "php": "^8.3 || ^8.4"
    },
    "extra": {
        "laravel": {
            "providers": [
                "ABTests\\ABTestingServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M"
    },
    "require-dev": {
        "illuminate/config": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "larastan/larastan": "^3.10",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^12.0 || ^13.0",
        "vlucas/phpdotenv": "^5.6",
        "laravel/framework": "^12.0 || ^13.0",
        "mockery/mockery": "^1.6"
    }
}
